{
    "name": "@doist/reactist",
    "description": "Open source React components by Doist",
    "version": "37.3.1",
    "repository": "https://github.com/Doist/reactist",
    "homepage": "https://github.com/Doist/reactist#readme",
    "bugs": {
        "url": "https://github.com/Doist/reactist/issues"
    },
    "author": {
        "name": "Henning Muszynski",
        "email": "henning@doist.com",
        "url": "http://doist.com"
    },
    "license": "MIT",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "prettier": "@doist/prettier-config",
    "main": "lib/index.js",
    "module": "es/index.js",
    "typings": "lib/index.d.ts",
    "unpkg": "dist/reactist.cjs.production.min.js",
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "CHANGELOG.md",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "codemods/README.md",
        "codemods/text-variants.ts",
        "dist/**",
        "es/**",
        "lib/**",
        "styles/**"
    ],
    "scripts": {
        "postinstall": "patch-package",
        "setup": "npm install && npm run validate",
        "validate": "npm run lint && npm run type-check && npm run type-check:react18 && npm run test && npm run test:react18",
        "start": "ON_SUCCESS=\"./scripts/organize-styles.sh\" rollup -c --watch --no-watch.clearScreen",
        "prestart:yalc": "npm run clean && yalc publish",
        "start:yalc": "ON_SUCCESS=\"npm run start:yalc:success\" rollup -c --watch --no-watch.clearScreen",
        "poststart:yalc": "yalc installations clean",
        "start:yalc:success": "./scripts/organize-styles.sh && yalc push --sig",
        "build": "scripts/build.sh",
        "build:storybook": "storybook build -o storybook-static",
        "clean": "rimraf es lib styles dist",
        "test": "jest --passWithNoTests",
        "test:watch": "npm run test -- --watch",
        "test:react18": "jest --config jest.config.react18.js",
        "test:react18:watch": "npm run test:react18 -- --watch",
        "test:coverage": "npm run test -- --coverage",
        "type-check": "tsc --noEmit -p ./tsconfig.json",
        "type-check:react18": "tsc --noEmit -p ./tsconfig.react18.json",
        "lint": "eslint --format codeframe --cache --ext js,jsx,ts,tsx ./",
        "storybook": "storybook dev -p 6006",
        "prettify": "prettier --write \"./**/*.{js,jsx,ts,tsx,json,css,scss,less,md}\"",
        "plop": "plop"
    },
    "peerDependencies": {
        "@ariakit/react": "~0.4.19",
        "classnames": "^2.2.5",
        "react": ">=18.0.0 <20.0.0",
        "react-compiler-runtime": "^1.0.0",
        "react-dom": ">=18.0.0 <20.0.0",
        "react-transition-group": "^4.4.5"
    },
    "devDependencies": {
        "@ariakit/react": "0.4.19",
        "@babel/cli": "7.29.7",
        "@babel/core": "7.29.7",
        "@babel/plugin-transform-runtime": "7.29.7",
        "@babel/preset-env": "7.29.7",
        "@babel/preset-react": "7.29.7",
        "@babel/preset-typescript": "7.29.7",
        "@babel/register": "7.29.7",
        "@doist/eslint-config": "13.1.1",
        "@doist/prettier-config": "4.0.1",
        "@doist/product-libraries-tokens": "1.3.2",
        "@doist/react-compiler-tracker": "3.0.1",
        "@doist/tsconfig": "2.0.1",
        "@rollup/plugin-babel": "7.1.0",
        "@rollup/plugin-commonjs": "29.0.3",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-terser": "1.0.0",
        "@rollup/plugin-typescript": "12.3.0",
        "@semantic-release/changelog": "6.0.3",
        "@semantic-release/exec": "7.1.0",
        "@semantic-release/git": "10.0.1",
        "@storybook/addon-docs": "10.5.10",
        "@storybook/react-vite": "10.5.10",
        "@tanstack/react-table": "9.1.2",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.6",
        "@types/classnames": "2.3.4",
        "@types/jest": "28.1.8",
        "@types/jest-axe": "3.5.9",
        "@types/jscodeshift": "17.3.0",
        "@types/marked": "4.3.2",
        "@types/react": "19.2.18",
        "@types/react-18": "npm:@types/react@18.3.31",
        "@types/react-dom": "19.2.4",
        "@types/react-dom-18": "npm:@types/react-dom@18.3.7",
        "@types/react-transition-group": "4.4.12",
        "@typescript-eslint/eslint-plugin": "8.46.2",
        "@typescript-eslint/parser": "8.46.2",
        "@vitejs/plugin-react": "6.1.0",
        "autoprefixer": "10.5.4",
        "babel-plugin-react-compiler": "1.0.0",
        "chromatic": "18.5.0",
        "classnames": "2.5.1",
        "conventional-changelog-conventionalcommits": "10.4.0",
        "cssnano": "8.0.8",
        "eslint": "8.57.1",
        "eslint-config-prettier": "^8.5.0",
        "eslint-formatter-codeframe": "^7.32.1",
        "eslint-plugin-jest": "28.14.0",
        "eslint-plugin-jsx-a11y": "^6.5.1",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-react": "7.37.5",
        "find-up": "8.0.0",
        "husky": "9.1.7",
        "jest": "28.1.3",
        "jest-axe": "11.0.0",
        "jest-environment-jsdom": "28.1.3",
        "jscodeshift": "17.4.0",
        "less": "4.9.0",
        "lint-staged": "17.3.0",
        "marked": "4.3.0",
        "mockdate": "3.0.5",
        "plop": "4.0.5",
        "prettier": "3.6.2",
        "react": "19.2.8",
        "react-18": "npm:react@18.3.1",
        "react-compiler-runtime": "1.0.0",
        "react-docgen-typescript": "2.4.0",
        "react-dom": "19.2.8",
        "react-dom-18": "npm:react-dom@18.3.1",
        "react-is": "19.2.8",
        "react-transition-group": "4.4.5",
        "rimraf": "6.1.3",
        "rollup": "2.80.0",
        "rollup-plugin-styles": "4.0.0",
        "rollup-plugin-visualizer": "7.1.1",
        "semantic-release": "25.0.9",
        "storybook": "10.5.10",
        "tslib": "2.8.1",
        "typescript": "5.9.3",
        "vite": "8.2.2"
    },
    "dependencies": {
        "@babel/runtime": "7.29.7",
        "aria-hidden": "1.2.6",
        "dayjs": "1.11.23",
        "patch-package": "8.0.1",
        "react-focus-lock": "2.13.7",
        "react-keyed-flatten-children": "1.3.0",
        "react-markdown": "5.0.3",
        "use-callback-ref": "1.3.3"
    },
    "overrides": {
        "pretty-format": {
            "react-is": "$react-is"
        },
        "react-element-to-jsx-string": "15.0.0",
        "react-dom-18": {
            "react": "$react"
        },
        "@types/react-dom-18": {
            "@types/react": "$@types/react"
        }
    }
}
